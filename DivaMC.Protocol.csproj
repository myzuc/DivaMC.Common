<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.0.1</Version>
        <Company>myzuc.net</Company>
        <AssemblyVersion>0.0.1</AssemblyVersion>
        <FileVersion>0.0.1</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <RootNamespace>DivaMC.Common</RootNamespace>
        <Title>DivaMC.Protocol</Title>
        <Authors>DivaShioko</Authors>
        <Copyright>Copyright (c) 2026 myzuc.net</Copyright>
        <PackageProjectUrl>https://github.com/myzuc/DivaMC.Protocol/</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/myzuc/DivaMC.Protocol/LICENSE.md</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/myzuc/DivaMC.Shared.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>minecraft, protocol</PackageTags>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Common\Objects\" />
      <Folder Include="Dialogs\" />
      <Folder Include="Tablist\" />
      <Folder Include="World\Entities\" />
      <Folder Include="World\Events\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="fNbt" Version="2.1.0" />
      <PackageReference Include="System.Text.Json" Version="11.0.0-rc.2.26504.105" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="DivaMC.Protocol.sln.DotSettings" />
    </ItemGroup>

</Project>
